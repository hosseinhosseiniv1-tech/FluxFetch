# =============================================
# FluxFetch | Universal Downloader — env template
# =============================================

# ---- REQUIRED ----
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ---- OPTIONAL ----

# DOWNLOAD_DIR=downloads

# Set to "true" ONLY if you have Telegram Premium
# AND valid custom emoji IDs filled in PREMIUM_EMOJI_IDS.
BOT_OWNER_HAS_PREMIUM=false

# YouTube cookies (paste full cookies.txt content as one line)
# Export from browser with "Get cookies.txt LOCALLY" extension.
# Use a DUMMY account, not your main one.
# YOUTUBE_COOKIES=

# Residential proxy (only if YouTube still blocks)
# PROXY_URL=http://user:pass@proxy-host:port
